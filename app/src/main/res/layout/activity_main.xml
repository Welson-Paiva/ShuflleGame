<?xml version="1.0" encoding="utf-8"?>

<!-- ========================================== -->
<!-- FRAME PRINCIPAL -->
<!-- ========================================== -->

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="match_parent">

    <!-- ========================================== -->
    <!-- FUNDO -->
    <!-- ========================================== -->

    <ImageView
        android:layout_width="match_parent"

        android:layout_height="match_parent"

        android:src="@drawable/fundo_madeira"

        android:scaleType="centerCrop"/>

    <!-- ========================================== -->
    <!-- CAMADA ESCURA -->
    <!-- ========================================== -->

    <View
        android:layout_width="match_parent"

        android:layout_height="match_parent"

        android:background="#B3000000"/>

    <!-- ========================================== -->
    <!-- SCROLL -->
    <!-- ========================================== -->

    <ScrollView
        android:layout_width="match_parent"

        android:layout_height="match_parent">

        <!-- ========================================== -->
        <!-- CONTAINER -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">

            <!-- ========================================== -->
            <!-- TÍTULO -->
            <!-- ========================================== -->

            <TextView
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="SHUFFLE GAME"

                android:textColor="#FFFFFF"

                android:textSize="34sp"

                android:textStyle="bold"

                android:layout_gravity="center_horizontal"

                android:layout_marginTop="20dp"

                android:layout_marginBottom="25dp"/>

            <!-- ========================================== -->
            <!-- CARD PERFIL -->
            <!-- ========================================== -->

            <LinearLayout
                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:padding="18dp"

                android:background="#CC1E1E1E"

                android:layout_marginBottom="25dp">

                <!-- AVATAR -->
                <ImageView
                    android:id="@+id/imgAvatar"

                    android:layout_width="90dp"

                    android:layout_height="90dp"

                    android:src="@drawable/avatar1"

                    android:scaleType="centerCrop"/>

                <!-- INFO -->
                <LinearLayout
                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:layout_marginStart="18dp"

                    android:gravity="center_vertical">

                    <!-- NOME -->
                    <TextView
                        android:id="@+id/txtNome"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Jogador"

                        android:textColor="#FFFFFF"

                        android:textSize="24sp"

                        android:textStyle="bold"/>

                    <!-- RECORDE -->
                    <TextView
                        android:id="@+id/txtRecorde"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Melhor tempo: 0s"

                        android:textColor="#00E5FF"

                        android:textSize="18sp"

                        android:layout_marginTop="10dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- BOTÃO JOGAR -->
            <!-- ========================================== -->

            <Button
                android:id="@+id/btnJogar"

                android:layout_width="match_parent"

                android:layout_height="65dp"

                android:text="JOGAR"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:textSize="20sp"

                android:backgroundTint="#00C853"

                android:layout_marginBottom="30dp"/>

            <!-- ========================================== -->
            <!-- CARD MODOS -->
            <!-- ========================================== -->

            <LinearLayout
                android:id="@+id/layoutModos"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:background="#CC1E1E1E"

                android:padding="20dp"

                android:visibility="gone"

                android:layout_marginBottom="30dp">

                <!-- TEXTO -->
                <TextView
                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="ESCOLHA A DIFICULDADE"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="22sp"

                    android:layout_gravity="center_horizontal"

                    android:layout_marginBottom="25dp"/>

                <!-- FÁCIL -->
                <Button
                    android:id="@+id/btnFacil"

                    android:layout_width="match_parent"

                    android:layout_height="60dp"

                    android:text="FÁCIL"

                    android:textStyle="bold"

                    android:textColor="#FFFFFF"

                    android:backgroundTint="#00C853"

                    android:layout_marginBottom="15dp"/>

                <!-- MÉDIO -->
                <Button
                    android:id="@+id/btnMedio"

                    android:layout_width="match_parent"

                    android:layout_height="60dp"

                    android:text="MÉDIO"

                    android:textStyle="bold"

                    android:textColor="#FFFFFF"

                    android:backgroundTint="#FF9800"

                    android:layout_marginBottom="15dp"/>

                <!-- DIFÍCIL -->
                <Button
                    android:id="@+id/btnDificil"

                    android:layout_width="match_parent"

                    android:layout_height="60dp"

                    android:text="DIFÍCIL"

                    android:textStyle="bold"

                    android:textColor="#FFFFFF"

                    android:backgroundTint="#F44336"/>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- TEXTO RANKING -->
            <!-- ========================================== -->

            <TextView
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="RANKING"

                android:textColor="#FFFFFF"

                android:textSize="28sp"

                android:textStyle="bold"

                android:layout_gravity="center_horizontal"

                android:layout_marginBottom="20dp"/>

            <!-- ========================================== -->
            <!-- LISTA RANKING -->
            <!-- ========================================== -->

            <LinearLayout
                android:id="@+id/layoutRanking"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>